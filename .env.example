# AgriSense AI Environment Variables
# Copy this file to .env and configure as needed.

# Weather Provider Configuration
# Open-Meteo does not require an API key for development/non-commercial use.
# For commercial or high-volume usage, configure your customer API key below:
WEATHER_API_KEY=your_api_key_here
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10.0
