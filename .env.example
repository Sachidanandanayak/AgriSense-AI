# AgriSense AI Environment Variables
# Copy this file to .env and configure as needed.

# Weather Provider Configuration
# Open-Meteo does not require an API key for development/non-commercial use.
# For commercial or high-volume usage, configure your customer API key below:
WEATHER_API_KEY=your_api_key_here
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10.0

# Google Earth Engine Configuration (Phase 5 - Satellite Integration)
# 1. Earth Engine requires an active Google Cloud Project with the Earth Engine API enabled.
# 2. For local development:
#    - Authenticate via CLI: `earthengine authenticate`
#    - Set EARTHENGINE_PROJECT to your Google Cloud project ID (e.g., ee-your-project).
# 3. For automated / server environments:
#    - Provide a GCP Service Account email and either the path to a JSON key file or private key.
# IMPORTANT: Never commit service account private keys or real tokens into Git!
EARTHENGINE_PROJECT=your_gcp_project_id_here
EARTHENGINE_SERVICE_ACCOUNT=
EARTHENGINE_KEY_FILE=
EARTHENGINE_PRIVATE_KEY=
EARTHENGINE_TIMEOUT_SECONDS=25.0

# Satellite Analysis Defaults
SATELLITE_DEFAULT_RADIUS_M=500.0
SATELLITE_DEFAULT_CLOUD_THRESHOLD=65.0

# Soil Provider Configuration (Phase 6 - Soil & Geospatial Integration)
# ISRIC SoilGrids 2.0 provides global 250m resolution digital soil mapping under CC BY 4.0.
# No API key is required, but requests must follow ISRIC's fair use policy.
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
SOILGRIDS_TIMEOUT_SECONDS=15.0
SOIL_DEFAULT_DEPTH=0-5cm
